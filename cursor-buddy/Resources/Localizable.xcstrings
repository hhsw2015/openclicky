    "Show OpenClicky cursor": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 OpenClicky 光标"
          }
        }
      }
    },
    "Keeps the cursor companion visible and ready for push-to-talk.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持光标助理可见并随时可按住说话。"
          }
        }
      }
    },
    "Tutor mode": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅导模式"
          }
        }
      }
    },
    "Watches for short pauses and offers small next-step guidance.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监测短暂停顿并给出下一步小提示。"
          }
        }
      }
    },
    "Wake-word listener": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒词监听"
