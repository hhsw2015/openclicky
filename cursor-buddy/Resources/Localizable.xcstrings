    "Launch OpenClicky at login": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机启动 OpenClicky"
          }
        }
      }
    },
    "Off by default. Turn on to have OpenClicky start automatically after login.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后 OpenClicky 会在登录时自动启动。"
          }
        }
      }
    },
    "Language": {
