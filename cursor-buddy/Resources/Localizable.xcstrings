          }
        }
      }
    },
    "Choose the UI language. Relaunch to apply.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择界面语言。重启后生效。"
