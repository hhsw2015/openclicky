    },
    "GPT Realtime listens directly to the microphone. Use the local listening route when you want Parakeet to transcribe first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT Realtime 直接接麦克风。若希望先由 Parakeet 转录,请使用本地识别链路。"
          }
        }
      }
    },
