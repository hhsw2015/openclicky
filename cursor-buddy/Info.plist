<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>AnthropicAPIKey</key>
	<string>$(ANTHROPIC_API_KEY)</string>
	<key>AssemblyAIAPIKey</key>
	<string>$(ASSEMBLYAI_API_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>OpenClicky</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openclicky</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>OpenClickyHeyClickyAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clicky</string>
				<string>heyclicky</string>
			</array>
		</dict>
	</array>
	<key>DeepgramAPIKey</key>
	<string>$(DEEPGRAM_API_KEY)</string>
	<key>DeepgramTranscriptionModel</key>
	<string>nova-3</string>
	<key>ElevenLabsAPIKey</key>
	<string>$(ELEVENLABS_API_KEY)</string>
	<key>ElevenLabsVoiceID</key>
	<string>$(ELEVENLABS_VOICE_ID)</string>
	<key>HeyClickyOAuthAuthorizeURL</key>
	<string>$(HEYCLICKY_OAUTH_AUTHORIZE_URL)</string>
	<key>HeyClickyProxyBaseURL</key>
	<string>$(HEYCLICKY_PROXY_BASE_URL)</string>
	<key>HeyClickySupabaseAnonKey</key>
	<string>$(HEYCLICKY_SUPABASE_ANON_KEY)</string>
	<key>HeyClickySupabaseURL</key>
	<string>$(HEYCLICKY_SUPABASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>OpenClicky uses Apple Events only when you ask it to automate local apps or System Events for guarded macOS control.</string>
	<key>NSCameraUsageDescription</key>
	<string>OpenClicky uses the selected camera only when you enable visual intelligence or meeting notes, so it can understand camera images and visible text.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenClicky uses the microphone for push-to-talk voice input, optional “Hey Clicky” wake-word listening, and optional meeting notes transcription.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>OpenClicky needs screen recording access to see your screen and help you.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OpenClicky uses on-device speech recognition to detect the optional “Hey Clicky” wake phrase when hands-free listening is enabled.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>OpenClicky reads window titles and focused-text so its assistant knows which app you're using. Nothing leaves your Mac.</string>
	<key>NSInputMonitoringUsageDescription</key>
	<string>OpenClicky watches keyboard and mouse events (only when Screen History event capture is enabled) to correlate captures with what you were doing. Nothing leaves your Mac.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>OpenClicky syncs calendar events so meetings show up in Screen History timelines. Only when calendar sync is enabled.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>OpenClicky syncs calendar events so meetings show up in Screen History timelines. Only when calendar sync is enabled.</string>
	<key>NSUserNotificationAlertStyle</key>
	<string>alert</string>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/jasonkneen/openclicky/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>fXYcC2zX+zTEH0DVS8io8agfHtphoB9/o6J33T9FLdk=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>VoiceTranscriptionProvider</key>
	<string>automatic</string>
</dict>
</plist>
