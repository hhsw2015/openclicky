# Copy to hotkeys.env and adjust to match your bindings.
#
# Format is a single shorthand string parsed by capture-*.sh:
#   modifiers separated by "+" then the key. Modifier tokens:
#     cmd | command
#     ctrl | control
#     alt | option
#     shift
#   Key is a single character or one of: space, return, tab, escape.
#
# Everywhere default (per Shortcut.SnapshotContext in settings.json):
EVERYWHERE_SNAPSHOT_KEY="shift+space"

# openclicky mirrors Everywhere by default. Change if you rebind.
OPENCLICKY_SNAPSHOT_KEY="shift+space"
